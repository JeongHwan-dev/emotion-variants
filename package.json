{
  "name": "emotion-variants",
  "version": "1.0.1",
  "description": "Type-safe variant API for Emotion",
  "keywords": [
    "emotion",
    "variants",
    "css-in-js",
    "typescript",
    "design-system"
  ],
  "author": "Jeonghwan Park",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JeongHwan-dev/emotion-variants"
  },
  "homepage": "https://github.com/JeongHwan-dev/emotion-variants#readme",
  "bugs": {
    "url": "https://github.com/JeongHwan-dev/emotion-variants/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "knip": "knip",
    "prepublishOnly": "pnpm build",
    "generate:labels": "node .github/scripts/generate-labels.mjs",
    "commit": "cz",
    "prepare": "husky",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "config": {
    "commitizen": {
      "path": "./commitizen.config.mjs"
    }
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@emotion/react": "^11.13.5",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@vitest/coverage-v8": "^3.2.7",
    "commitizen": "^4.3.1",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^16.2.7",
    "react": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "preact": "^10.28.2",
      "undici": "^7.18.2",
      "tmp": "^0.2.6",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.2",
      "browserslist": "^4.28.7",
      "fast-uri": "^3.1.4",
      "js-yaml@4": "^4.3.0",
      "lodash": "^4.18.1",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "nanoid@3": "^3.3.16",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "postcss": "^8.5.12",
      "rollup": "^4.59.0",
      "vite": "^6.4.3",
      "ws@8": "^8.21.0"
    }
  },
  "packageManager": "pnpm@9.0.0"
}
