{
  "name": "emotion-variants",
  "version": "2.1.0",
  "description": "Type-safe variant API for Emotion",
  "keywords": [
    "emotion",
    "variants",
    "css-in-js",
    "typescript",
    "design-system"
  ],
  "author": "Jeonghwan Park",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeongHwan-dev/emotion-variants.git"
  },
  "homepage": "https://emotion-variants.org",
  "bugs": {
    "url": "https://github.com/JeongHwan-dev/emotion-variants/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "knip": "knip",
    "docs:dev": "pnpm --filter emotion-variants-docs dev",
    "docs:build": "pnpm --filter emotion-variants-docs build",
    "docs:preview": "pnpm --filter emotion-variants-docs preview",
    "prepublishOnly": "pnpm build",
    "generate:labels": "node .github/scripts/generate-labels.mjs",
    "commit": "cz",
    "prepare": "husky",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "config": {
    "commitizen": {
      "path": "./commitizen.config.mjs"
    }
  },
  "peerDependencies": {
    "@emotion/css": "^11.0.0",
    "@emotion/react": "^11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.13.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@vitest/coverage-v8": "^5.1.0",
    "commitizen": "^4.3.1",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^16.2.7",
    "react": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.3.4"
}
